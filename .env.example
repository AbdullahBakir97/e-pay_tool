# Copy to .env and fill in. Never commit the real .env.

# eBay developer credentials (https://developer.ebay.com -> Application Keys)
EPAY_EBAY_ENV=sandbox              # sandbox | production
EPAY_EBAY_CLIENT_ID=
EPAY_EBAY_CLIENT_SECRET=
EPAY_EBAY_RU_NAME=                 # RuName of your app; its accept URL must point to http://localhost:8123/callback

# Marketplace
EPAY_EBAY_MARKETPLACE=EBAY_DE
EPAY_CONTENT_LANGUAGE=de-DE
EPAY_CURRENCY=EUR

# AI provider: gemini | ollama | none
# A missing key does not stop the app: it starts without AI, and barcode
# lookups through the eBay catalog keep working.
EPAY_AI_PROVIDER=gemini
EPAY_GEMINI_API_KEY=               # https://aistudio.google.com -> API key (free tier)
EPAY_GEMINI_MODEL=gemini-2.5-flash

# Optional local fallback via Ollama
EPAY_OLLAMA_URL=http://localhost:11434
EPAY_OLLAMA_MODEL=qwen2.5vl

# Listing defaults
EPAY_DEFAULT_CONDITION=NEW         # NEW | NEW_OTHER | USED_EXCELLENT | USED_GOOD | ...

# Pricing strategy
EPAY_UNDERCUT_PERCENT=3.0

# OAuth loopback
EPAY_OAUTH_CALLBACK_PORT=8123
